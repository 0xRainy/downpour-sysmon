#!/usr/bin/env python3
"""Sample CPU, RAM, and GPU telemetry for 0xrainy.sysmon."""
from __future__ import annotations

import glob
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path


def read_stat():
    rows = []
    with open("/proc/stat", encoding="utf-8") as handle:
        for line in handle:
            if not line.startswith("cpu"):
                break
            parts = line.split()
            nums = [int(x) for x in parts[1:]]
            idle = nums[3] + (nums[4] if len(nums) > 4 else 0)
            rows.append({"name": parts[0], "total": sum(nums), "idle": idle})
    return rows


def read_cpu_freq_mhz(logical: int) -> float | None:
    for name in ("scaling_cur_freq", "cpuinfo_cur_freq"):
        path = Path(f"/sys/devices/system/cpu/cpu{logical}/cpufreq/{name}")
        if not path.exists():
            continue
        try:
            # sysfs reports kHz
            return round(int(path.read_text(encoding="utf-8").strip()) / 1000.0, 0)
        except (OSError, ValueError):
            continue
    return None


def cpu_percents(prev, cur):
    prev_map = {row["name"]: row for row in prev}
    total_pct = 0.0
    cores = []
    for row in cur:
        old = prev_map.get(row["name"])
        pct = 0.0
        if old:
            dt = row["total"] - old["total"]
            di = row["idle"] - old["idle"]
            if dt > 0:
                pct = max(0.0, min(100.0, (dt - di) * 100.0 / dt))
        pct = round(pct, 1)
        if row["name"] == "cpu":
            total_pct = pct
        elif row["name"].startswith("cpu"):
            try:
                core_id = int(row["name"][3:])
            except ValueError:
                continue
            entry = {"id": core_id, "label": f"Core {core_id}", "percent": pct}
            freq = read_cpu_freq_mhz(core_id)
            if freq is not None:
                entry["freqMHz"] = freq
            cores.append(entry)
    cores.sort(key=lambda item: item["id"])
    return total_pct, cores


def read_coretemp():
    """Temps keyed like usage: Core 0..N-1 = Linux logical CPU index.

    Intel coretemp labels use architectural core IDs (0, 4, 8, … on hybrid
    parts). Map each logical CPU through topology/core_id so the temp popup
    lines up with the usage popup.
    """
    package_c = None
    by_arch_id: dict[int, float] = {}
    for path in sorted(glob.glob("/sys/class/hwmon/hwmon*/temp*_input")):
        chip_path = os.path.join(os.path.dirname(path), "name")
        try:
            chip = open(chip_path, encoding="utf-8").read().strip()
        except OSError:
            continue
        if chip != "coretemp":
            continue
        base = path[: -len("_input")]
        try:
            label = open(base + "_label", encoding="utf-8").read().strip()
        except OSError:
            label = os.path.basename(base)
        try:
            celsius = int(open(path, encoding="utf-8").read().strip()) / 1000.0
        except (OSError, ValueError):
            continue
        if label.lower().startswith("package"):
            package_c = celsius
            continue
        match = re.search(r"(\d+)\s*$", label)
        if not match:
            continue
        by_arch_id[int(match.group(1))] = celsius

    cores = []
    for logical in range(256):
        topo = Path(f"/sys/devices/system/cpu/cpu{logical}/topology/core_id")
        if not topo.exists():
            break
        try:
            arch_id = int(topo.read_text(encoding="utf-8").strip())
        except (OSError, ValueError):
            continue
        if arch_id not in by_arch_id:
            continue
        entry = {
            "id": logical,
            "label": f"Core {logical}",
            "celsius": round(by_arch_id[arch_id], 1),
        }
        freq = read_cpu_freq_mhz(logical)
        if freq is not None:
            entry["freqMHz"] = freq
        cores.append(entry)

    if package_c is None and cores:
        package_c = sum(item["celsius"] for item in cores) / len(cores)
    return {
        "packageC": None if package_c is None else round(float(package_c), 1),
        "cores": cores,
    }


def read_ram():
    info = {}
    with open("/proc/meminfo", encoding="utf-8") as handle:
        for line in handle:
            parts = line.split()
            if len(parts) < 2:
                continue
            key = parts[0].rstrip(":")
            try:
                info[key] = int(parts[1]) * 1024  # KiB -> bytes
            except ValueError:
                continue
    total = info.get("MemTotal", 0)
    available = info.get("MemAvailable", info.get("MemFree", 0))
    used = max(0, total - available)
    percent = 0.0 if total <= 0 else round(used * 100.0 / total, 1)
    return {
        "percent": percent,
        "usedBytes": used,
        "totalBytes": total,
        "availableBytes": available,
    }


def read_gpu():
    nvidia = subprocess.run(
        [
            "nvidia-smi",
            "--query-gpu=name,utilization.gpu,temperature.gpu,memory.used,memory.total,clocks.current.graphics",
            "--format=csv,noheader,nounits",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if nvidia.returncode == 0 and nvidia.stdout.strip():
        parts = [p.strip() for p in nvidia.stdout.strip().splitlines()[0].split(",")]
        if len(parts) >= 5:
            try:
                gpu = {
                    "name": parts[0],
                    "percent": float(parts[1]),
                    "tempC": float(parts[2]),
                    "usedBytes": int(float(parts[3]) * 1024 * 1024),
                    "totalBytes": int(float(parts[4]) * 1024 * 1024),
                    "kind": "nvidia",
                }
                if len(parts) >= 6 and parts[5] not in ("", "[N/A]", "N/A"):
                    gpu["freqMHz"] = float(parts[5])
                return gpu
            except ValueError:
                pass

    # AMD sysfs fallback
    for busy in glob.glob("/sys/class/drm/card*/device/gpu_busy_percent"):
        dev = Path(busy).parent
        try:
            percent = float(open(busy, encoding="utf-8").read().strip())
        except (OSError, ValueError):
            continue
        temp_c = None
        for hw in glob.glob(str(dev / "hwmon/hwmon*/temp*_input")):
            label_path = hw.replace("_input", "_label")
            label = ""
            try:
                label = open(label_path, encoding="utf-8").read().strip().lower()
            except OSError:
                pass
            if label and label not in {"edge", "junction", ""} and "edge" not in label:
                continue
            try:
                temp_c = int(open(hw, encoding="utf-8").read().strip()) / 1000.0
                break
            except (OSError, ValueError):
                continue
        freq_mhz = None
        sclk = dev / "pp_dpm_sclk"
        if sclk.exists():
            try:
                for line in sclk.read_text(encoding="utf-8").splitlines():
                    if "*" in line:
                        match = re.search(r"(\d+)\s*Mhz", line, re.I)
                        if match:
                            freq_mhz = float(match.group(1))
                            break
            except OSError:
                pass
        gpu = {
            "name": "AMD GPU",
            "percent": percent,
            "tempC": temp_c,
            "usedBytes": None,
            "totalBytes": None,
            "kind": "amdgpu",
        }
        if freq_mhz is not None:
            gpu["freqMHz"] = freq_mhz
        return gpu
    return None

def main() -> int:
    a = read_stat()
    time.sleep(0.15)
    b = read_stat()
    cpu_pct, cores = cpu_percents(a, b)
    payload = {
        "cpu": {"percent": cpu_pct, "cores": cores},
        "cpuTemp": read_coretemp(),
        "ram": read_ram(),
        "gpu": read_gpu(),
    }
    json.dump(payload, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
