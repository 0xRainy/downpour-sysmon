{
  "$schema": "https://raw.githubusercontent.com/omarchy/omarchy/main/schemas/plugin.json",
  "schemaVersion": 1,
  "id": "downpour.sysmon",
  "name": "downpour-sysmon",
  "version": "1.0.0",
  "author": "0xRainy",
  "license": "MIT",
  "description": "A no-frills Omarchy system monitor: CPU, RAM, and GPU at a glance.",
  "repository": "https://github.com/0xRainy/downpour-sysmon",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "downpour-sysmon",
    "description": "Simple CPU / RAM / GPU chips with sparklines and alerts",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "cpuWarnPercent": 80,
      "cpuTempWarnC": 80,
      "ramWarnPercent": 80,
      "gpuWarnPercent": 80,
      "gpuTempWarnC": 80,
      "showCpu": true,
      "showCpuTemp": true,
      "showRam": true,
      "showGpu": true,
      "showGpuTemp": true,
      "showCpuGraph": true,
      "showCpuTempGraph": true,
      "showRamGraph": true,
      "showGpuGraph": true,
      "showGpuTempGraph": true,
      "showCpuFreq": false,
      "showGpuFreq": false
    },
    "schema": [
      {
        "key": "cpuWarnPercent",
        "type": "integer",
        "label": "CPU usage alert (%)",
        "min": 50,
        "max": 100,
        "step": 5,
        "defaultValue": 80
      },
      {
        "key": "cpuTempWarnC",
        "type": "integer",
        "label": "CPU temp alert (\u00b0C)",
        "min": 50,
        "max": 110,
        "step": 5,
        "defaultValue": 80
      },
      {
        "key": "ramWarnPercent",
        "type": "integer",
        "label": "RAM usage alert (%)",
        "min": 50,
        "max": 100,
        "step": 5,
        "defaultValue": 80
      },
      {
        "key": "gpuWarnPercent",
        "type": "integer",
        "label": "GPU usage alert (%)",
        "min": 50,
        "max": 100,
        "step": 5,
        "defaultValue": 80
      },
      {
        "key": "gpuTempWarnC",
        "type": "integer",
        "label": "GPU temp alert (\u00b0C)",
        "min": 50,
        "max": 110,
        "step": 5,
        "defaultValue": 80
      },
      {
        "key": "showCpu",
        "type": "boolean",
        "label": "Show CPU usage chip",
        "defaultValue": true
      },
      {
        "key": "showCpuTemp",
        "type": "boolean",
        "label": "Show CPU temp chip",
        "defaultValue": true
      },
      {
        "key": "showRam",
        "type": "boolean",
        "label": "Show RAM chip",
        "defaultValue": true
      },
      {
        "key": "showGpu",
        "type": "boolean",
        "label": "Show GPU usage chip",
        "defaultValue": true
      },
      {
        "key": "showGpuTemp",
        "type": "boolean",
        "label": "Show GPU temp chip",
        "defaultValue": true
      },
      {
        "key": "showCpuGraph",
        "type": "boolean",
        "label": "CPU usage graph",
        "defaultValue": true
      },
      {
        "key": "showCpuTempGraph",
        "type": "boolean",
        "label": "CPU temp graph",
        "defaultValue": true
      },
      {
        "key": "showRamGraph",
        "type": "boolean",
        "label": "RAM graph",
        "defaultValue": true
      },
      {
        "key": "showGpuGraph",
        "type": "boolean",
        "label": "GPU usage graph",
        "defaultValue": true
      },
      {
        "key": "showGpuTempGraph",
        "type": "boolean",
        "label": "GPU temp graph",
        "defaultValue": true
      },
      {
        "key": "showCpuFreq",
        "type": "boolean",
        "label": "Per-core CPU frequency",
        "defaultValue": false
      },
      {
        "key": "showGpuFreq",
        "type": "boolean",
        "label": "GPU frequency",
        "defaultValue": false
      }
    ]
  },
  "homepage": "https://github.com/0xRainy/downpour-sysmon"
}
